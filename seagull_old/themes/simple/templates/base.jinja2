<!DOCTYPE html>
<html lang="{{ obj.lang }}">
    <head>{% block head %}
        <title>{% block title %}{{ site.name|striptags }}{% endblock title %}</title>
        <meta charset="utf-8"/>
        <meta name="generator" content="Seagull"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        {% import 'utils/translations.jinja2' as translations with context %}
        {{ translations.list_translation_head(obj) }}
    {% endblock head %}</head>
    <body>{% block body %}
        <header>
        {% block header %}
            <hgroup>
                {# TODO use index url instead #}
                <h1><a href="{{ site_root }}/">{{ site.name }}</a></h1>
            </hgroup>
        {% endblock header %}
        {% block nav %}
            <nav>
                <ul>
                    {% for p in site.objects.pages if p.lang == obj.lang and p.status not in ('hidden', 'draft') %}
                        <li><a href="{{ site_root }}/{{ p.url }}" {% if p is sameas obj %}
                               aria-current="page" {% endif %}>{{ p.name }}</a></li>
                    {% endfor %}
                </ul>
            </nav>
        {% endblock nav %}
        </header>
        <main>{% block content %}

        {% endblock content %}</main>
        <footer>{% block footer %}
            <address>
                {% trans trimmed seagull_url="https://github.com/gjorando/seagull", python_url="https://www.python.org/" %}
                    Proudly powered by <a rel="nofollow" href="{{ seagull_url }}">Seagull</a>,
                    which takes great advantage of <a rel="nofollow" href="{{ python_url }}">Python</a>.
                {% endtrans %}
            </address>
        {% endblock footer %}</footer>
    {% endblock body %}</body>
</html>
