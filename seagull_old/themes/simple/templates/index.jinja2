{% extends "base.jinja2" %}

{% block title %}{{ site.name|striptags }} - {{ obj.name|striptags }}{% endblock title %}

{% block content %}
    <header>
        <h2>{{ obj.name }}</h2>
    </header>
    {% if obj.content %}<section>{{ obj.content }}</section>{% endif %}

    <ul>
    {% for o in obj.objects if o.lang == obj.lang and o.status not in ('hidden', 'draft') %}
            <li><a href="{{ site_root }}/{{ o.url }}" rel="bookmark" title="Permalink to {{ o.name|striptags }}">{{ o.name }}</a></li>
    {% endfor %}
    </ul>

    {# TODO pagination #}
{% endblock content %}
