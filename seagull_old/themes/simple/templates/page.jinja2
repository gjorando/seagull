{% extends "base.jinja2" %}

{% block title %}{{ site.name|striptags }} - {{ obj.name|striptags }}{% endblock title %}

{% block content %}
    <article>
        <header>
            <h2>{{ obj.name }}</h2>
        </header>

        {% import 'utils/translations.jinja2' as translations with context %}
        {{ translations.list_translations(page) }}
        {{ obj.content }}
    </article>
{% endblock content %}
