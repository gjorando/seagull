{% extends "base.jinja2" %}

{% block title %}{{ site.name|striptags }} - {{ obj.name|striptags }}{% endblock title %}

{% block content %}
    <article>
        <header>
            <h2>{{ obj.name }}</h2>
            <p>{{ obj.date|strftime(date_format="full", strip_time=True) }}</p>
            {% import 'utils/translations.jinja2' as translations with context %}
            <p>{{ translations.list_translations(obj) }}</p>
        </header>
        {{ obj.content }}
        <footer>
            {% if obj.modified %}{% trans trimmed modified_date=obj.modified|strftime(date_format="full", strip_time=True) %}
                <p>Last updated: {{ modified_date }}</p>
            {% endtrans %}{% endif %}
        </footer>
    </article>
{% endblock content %}
